{"id":"2010-scene-pullback-pro","revision":0,"last_node_id":259,"last_link_id":434,"nodes":[{"id":1,"type":"FallingTSMarkDownTable","pos":[670,573],"size":[480,1410],"flags":{},"order":0,"mode":0,"inputs":[{"localized_name":"data","name":"data","type":"FALLINGTS_MD_TABLE","widget":{"name":"data"}}],"outputs":[{"name":"ID","type":"STRING","slot_index":0,"links":[15,16]},{"name":"原场景","type":"IMAGE","slot_index":1,"links":[13,61]},{"name":"扩展-正词","type":"STRING","slot_index":2,"links":[14]},{"name":"扩展-负词","type":"STRING","slot_index":3,"links":[418]},{"name":"图2","type":"IMAGE","slot_index":4,"links":[96,426]},{"name":"图3","type":"IMAGE","slot_index":5,"links":[97,427]},{"name":"优化-正词","type":"STRING","slot_index":6,"links":[38]},{"name":"优化-负词","type":"STRING","slot_index":7,"links":[416]},{"name":"整行数据","type":"STRING","slot_index":8,"links":null}],"title":"MD 数据表 (场景拉镜)","properties":{"Node name for S&R":"FallingTSMarkDownTable","cnr_id":"comfy-core","ue_properties":{"widget_ue_connectable":{"data":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":[{"md_path":"stories/七纹刻印/0021_场景拉镜.md","fields":[{"name":"ID","type":"STRING"},{"name":"原场景","type":"IMAGE"},{"name":"扩展-正词","type":"TEXT"},{"name":"扩展-负词","type":"TEXT"},{"name":"图2","type":"IMAGE"},{"name":"图3","type":"IMAGE"},{"name":"优化-正词","type":"TEXT"},{"name":"优化-负词","type":"TEXT"}],"selected":{"id":"00001_书房","values":{"ID":"00001_书房","原场景":"@{0020_场景首帧/00001_书房}","扩展-正词":"将原本的深夜书房前面画面向后拉开镜头作全景扩图，保留原有中央书桌、银色笔记本电脑、黑色台灯、屏幕朝下扣在桌面上的黑色手机与窗边深色厚窗帘，四周自然延伸出完整书房空间，突出书房的写作与起居属性\n整个书房为平面近似正方形的十平方米独立房间（约 3.1 米×3.2 米，四面墙长度相近、轮廓接近正方形），深蓝灰色墙面、浅色木地板、深色平顶天花板，四面墙在房间四角以直角相接、墙脚一圈深棕色踢脚线绕墙一周连续不断开，画面按九宫格布局\n左上是前面墙左边深色厚窗帘垂在窗边，窗帘后面是黑框大窗的上角\n左边是左墙靠前段墙面上挂着的浅木色边框小黑板，黑板下方一只深色木质矮几、几上放着一只白瓷杯与一小摞书\n左下是左墙后段墙脚一盆白色花盆的绿植，盆底与浅色木地板相接，地板上铺着一块浅灰色小地毯的一角\n上边是前面墙上沿与偏左的黑框大窗，玻璃上糊着水汽与细密雨痕，窗外是小雨的夜、天空墨黑接近全黑，远处多栋高楼的霓虹灯牌与零星窗灯在雨雾里晕开\n中间是房间中央偏后的深色木质书桌，桌上放着亮着冷白文档的银色笔记本电脑，电脑右侧一只屏幕朝下扣在桌面上的黑色手机，旁边一小摞立着的书、摊开的草稿本与几支笔，黑色台灯的暖光落在桌面上\n下边是浅色木地板延伸到画面底部、地面微微反光，桌腿旁放着黑色转椅与浅灰小地毯一角\n右上是右墙与前面墙之间的直角墙角，深蓝灰色墙面干净、深棕色踢脚线在墙角处连续不断开\n右边是右墙靠前段立着的一座深色木质矮书架、层板上摆着十几本书，书架层板边缘被台灯暖光斜扫出一道亮边\n右下是右墙靠后段一扇关着的深棕色木门、同色门框与银色门把手、门边墙上一只白色方形开关面板，门口地板上拖着一条细长的暖光\n整个近正方形空间以书桌、台灯、矮书架、矮几、绿植、窗户与转椅构成简约安静的工作区，四面墙各自只有一处陈设、墙面其余部分留白，整体是功能纯粹的居家书房\n写实三维CG风格，现代都市雨夜室内，暖黄台灯是室内主光，窗外远处高楼的霓虹形成冷暖对比，整体静谧压抑略带不安","扩展-负词":"低质量, 模糊, 变形, 透视错误, 多余物体, 多余肢体, 解剖错误, 二维动漫, 二次元平涂, 卡通渲染, 赛璐璐上色, 平面插画, 塑料感, 过度磨皮, 水印, 签名, 徽标, 过曝, 色彩过饱和, 边缘接缝, 重复纹理, 构图崩坏, 透视崩坏, 空间扭曲, 白天, 阳光","图2":"","图3":"","优化-正词":"以图1为底，保持扩图后整体构图与九宫格布局不变，画面背景光影层次不乱，进一步提升暖黄台灯与窗外远处高楼霓虹的冷暖对比、书桌上那摞书与笔记本电脑、草稿本、黑色手机的材质细节，以及深色木质矮书架、矮几与浅色木地板的质感，突出书房简约工作区的氛围，画面更真实更具电影感","优化-负词":"低质量, 模糊, 变形, 透视错误, 多余物体, 多余肢体, 解剖错误, 二维动漫, 二次元平涂, 卡通渲染, 赛璐璐上色, 平面插画, 塑料感, 过度磨皮, 水印, 签名, 徽标, 过曝, 色彩过饱和, 构图变化, 物件增减, 颜色偏移"}}}],"widgets_values_named":{"data":{"md_path":"stories/七纹刻印/0021_场景拉镜.md","fields":[{"name":"ID","type":"STRING"},{"name":"原场景","type":"IMAGE"},{"name":"扩展-正词","type":"TEXT"},{"name":"扩展-负词","type":"TEXT"},{"name":"图2","type":"IMAGE"},{"name":"图3","type":"IMAGE"},{"name":"优化-正词","type":"TEXT"},{"name":"优化-负词","type":"TEXT"}],"selected":{"id":"00001_书房","values":{"ID":"00001_书房","原场景":"@{0020_场景首帧/00001_书房}","扩展-正词":"将原本的深夜书房前面画面向后拉开镜头作全景扩图，保留原有中央书桌、银色笔记本电脑、黑色台灯、屏幕朝下扣在桌面上的黑色手机与窗边深色厚窗帘，四周自然延伸出完整书房空间，突出书房的写作与起居属性\n整个书房为平面近似正方形的十平方米独立房间（约 3.1 米×3.2 米，四面墙长度相近、轮廓接近正方形），深蓝灰色墙面、浅色木地板、深色平顶天花板，四面墙在房间四角以直角相接、墙脚一圈深棕色踢脚线绕墙一周连续不断开，画面按九宫格布局\n左上是前面墙左边深色厚窗帘垂在窗边，窗帘后面是黑框大窗的上角\n左边是左墙靠前段墙面上挂着的浅木色边框小黑板，黑板下方一只深色木质矮几、几上放着一只白瓷杯与一小摞书\n左下是左墙后段墙脚一盆白色花盆的绿植，盆底与浅色木地板相接，地板上铺着一块浅灰色小地毯的一角\n上边是前面墙上沿与偏左的黑框大窗，玻璃上糊着水汽与细密雨痕，窗外是小雨的夜、天空墨黑接近全黑，远处多栋高楼的霓虹灯牌与零星窗灯在雨雾里晕开\n中间是房间中央偏后的深色木质书桌，桌上放着亮着冷白文档的银色笔记本电脑，电脑右侧一只屏幕朝下扣在桌面上的黑色手机，旁边一小摞立着的书、摊开的草稿本与几支笔，黑色台灯的暖光落在桌面上\n下边是浅色木地板延伸到画面底部、地面微微反光，桌腿旁放着黑色转椅与浅灰小地毯一角\n右上是右墙与前面墙之间的直角墙角，深蓝灰色墙面干净、深棕色踢脚线在墙角处连续不断开\n右边是右墙靠前段立着的一座深色木质矮书架、层板上摆着十几本书，书架层板边缘被台灯暖光斜扫出一道亮边\n右下是右墙靠后段一扇关着的深棕色木门、同色门框与银色门把手、门边墙上一只白色方形开关面板，门口地板上拖着一条细长的暖光\n整个近正方形空间以书桌、台灯、矮书架、矮几、绿植、窗户与转椅构成简约安静的工作区，四面墙各自只有一处陈设、墙面其余部分留白，整体是功能纯粹的居家书房\n写实三维CG风格，现代都市雨夜室内，暖黄台灯是室内主光，窗外远处高楼的霓虹形成冷暖对比，整体静谧压