# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/

# ---- Syncthing 文件夹标记目录(运行时生成) ----
.stfolder/
.stignore

# ---- Syncthing 冲突副本与临时文件(双机同步生成,不入库) ----
*~syncthing~*.tmp
*.syncthing.*.tmp
.syncthing.*.tmp
*sync-conflict-*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 日志与缓存 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 密钥与环境 ----
.env
.env.*

# 根目录 temp/:超大文件编辑的应急脚本落盘处(见 AGENTS.md 开发规范),不入库
/temp/

# 技能临时产物(校验脚本落盘处,见 AGENTS.md 三条铁律 ③),不入库
/.agents/tmp/

# 运行时残留(记录上次运行 prompt 的 pid,每次执行都会变),不入库
/.agents/tmp_last_pid.txt

# 运行时临时文件(ComfyUI/temp 为运行时目录)
ComfyUI/temp/

# 根 input/(已于 2026-10-11 删除;由 ComfyUI-HYWM2 的 prestartup_script.py 每次启动
# 自动从 custom_nodes/ComfyUI-HYWM2/assets/ 复制回根目录 —— 因 ComfyUI/custom_nodes
# 是目录级软链接,其 parent.parent 回退到项目根而非 ComfyUI/,属插件侧路径推导偏差)
/input/

# 注:ComfyUI / 各插件 / ComfyUI-Docs 为 git submodule(见 .gitmodules),
# 由根仓库以 gitlink 引用管理,不再列入 .gitignore

# ---- ComfyUI 本地文件(不属于仓库,保留磁盘副本供插件加载) ----
/custom_nodes/example_node.py.example
/custom_nodes/websocket_image_save.py

# ---- 已退役/未登记的本地插件残留(独立 git clone,不属根仓库) ----
# comfyui-mixlab-nodes: 上游已移除(理由: 强改画布视图)
# ComfyUI-OrbitSheets:  工作流 0033 已退役
# ComfyUI-Qwen3-TTS:    人声链已改用 IndexTTS-2.5(TTS-Audio-Suite)
# 目录保留在磁盘供 ComfyUI 加载,不入库;确需清理时手动删除
/custom_nodes/comfyui-mixlab-nodes/
/custom_nodes/ComfyUI-OrbitSheets/
/custom_nodes/ComfyUI-Qwen3-TTS/

# ---- 本地运行时二进制(ffmpeg 等,体积大且可公开下载,不入库) ----
# tools/ffmpeg/ 合计约 523 MB,其中 ffmpeg.exe 单文件 169 MB
# 超过 GitHub 100 MB 单文件上限,提交会遭 push 拒绝
/tools/
